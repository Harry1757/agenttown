{
  "name": "codextown-app",
  "version": "1.0.0",
  "description": "AI 에이전트의 작업을 도트 마을로 보는 로컬 데스크톱 앱",
  "main": "src/main.js",
  "scripts": {
    "icons": "electron tools/build-icons.js",
    "start": "electron .",
    "sync-server": "node tools/sync-server.js",
    "dist:mac": "node tools/sync-server.js && electron-builder --mac dir",
    "dist:mac-dmg": "node tools/sync-server.js && electron-builder --mac dmg",
    "dist:win": "node tools/sync-server.js && node tools/build-windows-backend.js && electron-builder --win nsis --x64 --publish never"
  },
  "private": true,
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.codextown.app",
    "productName": "AgentTown",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "src/**",
      "server/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/claudetown.ico",
      "extraResources": [
        {
          "from": "backend-dist/codextown-server",
          "to": "backend"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AgentTown",
      "artifactName": "AgentTown-${version}-Windows-${arch}-Setup.${ext}"
    },
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "compression": "maximum",
    "electronLanguages": [
      "ko",
      "en-US"
    ]
  }
}
